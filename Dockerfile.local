# Build React once. Node is not needed in the running application.
FROM node:22-alpine AS frontend-build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Reuse the existing Python dependency image.
FROM ghcr.io/rishabhmannu/financebench-rag-agent-api:0.3.5
USER root
RUN pip install --no-cache-dir "llm-guard[onnxruntime]==0.3.16"
WORKDIR /app
# Replace inherited source so archived modules do not remain in the image.
RUN rm -rf /app/src /app/scripts /app/cli
# The dependency image includes the retired terminal-client executable.
RUN rm -f /usr/local/bin/financebench
COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY --from=frontend-build /frontend/dist /app/frontend/dist
LABEL maintainer="Tejas Ganesh"
USER appuser
