%% Registered nodes and edges of src/graph/builder.py.
%% The rendered PNG/SVG come from scripts/build_diagrams.py; per-version diagrams are in versions/.
flowchart TB
  subgraph intake["01  ·  UNDERSTAND THE QUESTION"]
    direction TB
    start_node(["START"])
    rbac_gate["rbac_gate<br/>Set allowed document types"]
    guardrails["guardrails<br/>Prompt injection checks<br/>Resolve follow-up context"]
    router["router<br/>Classify intent and complexity<br/>Company-filings scope only"]
    metadata_extractor["metadata_extractor<br/>Document questions only<br/>Company required · no year → latest<br/>Record unavailable companies/years"]
  end
  subgraph evidence["02  ·  GATHER RELEVANT EVIDENCE"]
    direction TB
    knowledge_base[("Qdrant · financial_docs_v3<br/>64,952 chunks with context headers<br/>[Company · Filing · Page · Section · Statement · Units]<br/>3,107 near-empty chunks removed")]
    retrieval["retrieval<br/>Question + finance terms dictionary<br/>Dense (voyage-finance-2) + BM25 keyword search<br/>100 candidates each · fused by rank (RRF) → 100"]
    reranker["reranker<br/>Voyage rerank-2.5 (local BGE as fallback)<br/>Keep top 12"]
    grader["grader<br/>Small model keeps relevant chunks"]
    query_rewriter["query_rewriter<br/>Rewrite the query and search again<br/>At most 2 retries"]
    research_agent["research_agent<br/>Plan sub-questions → search each → check → synthesize<br/>Same search, rerank and grader inside"]
    context_expander["context_expander<br/>Add the chunk before and after<br/>each kept chunk · size-capped"]
  end
  subgraph answer["03  ·  DRAFT, VERIFY AND RELEASE"]
    direction TB
    generator["generator<br/>Answer the available companies/years<br/>Number rules: units, year column, full precision"]
    hallucination_checker["hallucination_checker<br/>Check grounding; retry if not grounded"]
    hitl_gate["hitl_gate<br/>Expanded access: Admin approval"]
    response_formatter["response_formatter<br/>Answer + source references<br/>Warning if unverified · note on anything left out"]
  end
  subgraph exits["OTHER COMPLETED RESPONSES"]
    direction LR
    clarification_response["clarification_response<br/>Ask the user to clarify"]
    out_of_scope_response["out_of_scope_response<br/>Return the scope limitation"]
    no_info_response["no_info_response<br/>Name the filings searched<br/>or the companies available to this user"]
    blocked_response["blocked_response<br/>Safety refusal or reviewer rejection"]
  end
  end_node(["END"])

  start_node --> rbac_gate
  rbac_gate --> guardrails
  guardrails -->|"Safety check blocked"| blocked_response
  guardrails -->|"Clean input"| router
  router -->|"Question about a company"| metadata_extractor
  metadata_extractor -->|"Simple lookup"| retrieval
  metadata_extractor -->|"Research required"| research_agent
  metadata_extractor -->|"No usable company or year"| no_info_response
  router -->|"Greeting / unclear"| clarification_response
  router -->|"Out of scope"| out_of_scope_response
  knowledge_base -.- retrieval
  retrieval --> reranker
  reranker --> grader
  grader -->|"Enough relevant evidence"| context_expander
  grader -->|"Too little evidence;<br/>retries remain"| query_rewriter
  query_rewriter -->|"Search again"| retrieval
  grader -->|"Retry limit reached"| no_info_response
  research_agent -->|"Evidence collected"| context_expander
  research_agent -->|"No relevant evidence"| no_info_response
  context_expander --> generator
  generator --> hallucination_checker
  hallucination_checker -->|"Not grounded;<br/>retries remain"| generator
  hallucination_checker -->|"Grounded or retries used"| hitl_gate
  hitl_gate -->|"No review needed or approved"| response_formatter
  hitl_gate -->|"Rejected"| blocked_response
  response_formatter --> end_node
  blocked_response --> end_node
  clarification_response --> end_node
  out_of_scope_response --> end_node
  no_info_response --> end_node

  classDef boundary fill:#132D44,stroke:#132D44,color:#FFFFFF,stroke-width:2px;
  classDef intakeNode fill:#ECF2FC,stroke:#8AA8D1,color:#17334D,stroke-width:1.6px;
  classDef evidenceNode fill:#E5F5F0,stroke:#52A28E,color:#123D35,stroke-width:1.6px;
  classDef researchNode fill:#FFF3D8,stroke:#D5A447,color:#654B18,stroke-width:1.8px;
  classDef answerNode fill:#E7F0FC,stroke:#6699CE,color:#163C63,stroke-width:1.7px;
  classDef approvalNode fill:#F0E8FC,stroke:#9C70CD,color:#4B2C6C,stroke-width:2.3px;
  classDef exitNode fill:#F4F6F8,stroke:#A6B2BE,color:#3B4B5B,stroke-width:1.5px;
  classDef blockedNode fill:#FFF0EC,stroke:#CF8B78,color:#753E2D,stroke-width:1.7px;
  classDef storeNode fill:#FFFFFF,stroke:#52A28E,color:#123D35,stroke-width:1.6px;
  classDef resultNode fill:#132D44,stroke:#132D44,color:#FFFFFF,stroke-width:1.5px;
  class start_node,end_node boundary;
  class rbac_gate,guardrails,metadata_extractor,router intakeNode;
  class retrieval,reranker,grader,query_rewriter,context_expander evidenceNode;
  class knowledge_base storeNode;
  class research_agent researchNode;
  class generator,hallucination_checker,response_formatter answerNode;
  class hitl_gate approvalNode;
  class clarification_response,out_of_scope_response,no_info_response exitNode;
  class blocked_response blockedNode;
  class results resultNode;
  style intake fill:#F8FAFE,stroke:#D7E1EE,stroke-width:1px;
  style evidence fill:#F7FBF9,stroke:#D4E7DF,stroke-width:1px;
  style answer fill:#F8FAFD,stroke:#D6E2EF,stroke-width:1px;
  style exits fill:#FBFAF8,stroke:#E3DED6,stroke-width:1px;
