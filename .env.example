# Copy to .env and keep all private keys out of Git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GROQ_API_KEY=

# Default demo profile: all language-model calls use Groq.
FORCE_GROQ_ONLY=true
FORCE_OPENAI_ONLY=false
USE_GROQ_FAST_PATH=false
GENERATOR_MODEL=claude-sonnet-4-6
HALLUCINATION_MODEL=claude-sonnet-4-6
HIGH_STAKES_HALLUCINATION_MODEL=claude-sonnet-4-6
OPENAI_FALLBACK_MODEL=gpt-4o-mini
RESEARCH_AGENT_DECOMPOSE_MODEL=gpt-4o-mini
RESEARCH_AGENT_SUFFICIENCY_MODEL=gpt-4o-mini
RESEARCH_AGENT_SYNTHESIZE_MODEL=claude-sonnet-4-6
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
GROQ_ANSWER_MODEL=openai/gpt-oss-120b

# Must match the published knowledge base.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-finance-2
EMBEDDING_DIMENSIONS=1024
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=financial_docs
RETRIEVAL_TOP_K=50
RERANKER_TOP_K=8
RERANKER_DEVICE=cpu

# Generate private random values for the password and JWT signing key.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=
JWT_SECRET=
RESULT_CACHE_REDIS_HOST=localhost
RESULT_CACHE_REDIS_PORT=16380
RESULT_CACHE_REDIS_DB=1
RAG_RESULT_CACHE_TTL_SECONDS=604800
LANGCHAIN_TRACING_V2=false
LITELLM_URL=
## Local diagnostics (Compose sets an absolute container path).
REQUEST_TRACE_DIR=logs/traces

