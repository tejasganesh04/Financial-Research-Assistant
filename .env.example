# Copy to .env and keep all private keys out of Git.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GROQ_API_KEY=

# Default demo profile: all language-model calls use Groq.
FORCE_GROQ_ONLY=true
FORCE_OPENAI_ONLY=false
USE_GROQ_FAST_PATH=false
GENERATOR_MODEL=claude-sonnet-4-6
HALLUCINATION_MODEL=claude-sonnet-4-6
HIGH_STAKES_HALLUCINATION_MODEL=claude-sonnet-4-6
OPENAI_FALLBACK_MODEL=gpt-4o-mini
RESEARCH_AGENT_DECOMPOSE_MODEL=gpt-4o-mini
RESEARCH_AGENT_SUFFICIENCY_MODEL=gpt-4o-mini
RESEARCH_AGENT_SYNTHESIZE_MODEL=claude-sonnet-4-6
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
GROQ_ANSWER_MODEL=openai/gpt-oss-120b
# Free Groq allows 8,000 tokens per request per minute; keep added neighbouring text small.
NEIGHBOUR_CHAR_BUDGET=2000

# Must match the published knowledge base.
EMBEDDING_MODEL=voyage-finance-2
EMBEDDING_DIMENSIONS=1024
QDRANT_HOST=localhost
QDRANT_PORT=6333
# financial_docs after restoring; financial_docs_v3 once the contextual collection is built (LOCAL_SETUP.md).
QDRANT_COLLECTION=financial_docs
RETRIEVAL_TOP_K=100
RERANKER_TOP_K=12
# voyage: Voyage's reranker, falling back to the local model on failure; local: free local model only.
# rerank-2.5 is the measured setup and is billed at $0.05 per million tokens (about $0.001 per
# question, no free tokens); rerank-3 lists 200M free tokens. Voyage reranking needs a payment
# method on the Voyage account (see LOCAL_SETUP.md).
RERANKER_PROVIDER=voyage
VOYAGE_RERANK_MODEL=rerank-2.5
RERANKER_DEVICE=cpu

# Generate private random values for the password and JWT signing key, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=
JWT_SECRET=
LANGCHAIN_TRACING_V2=false

# Exact calculator for the answer model; it falls back to answering without it if tool calls fail.
CALCULATOR_ENABLED=true
CALCULATOR_MAX_ROUNDS=4

# Where people and MCP clients reach the app (https://your-domain in production).
PUBLIC_URL=http://localhost:8000

# Sign-in. Access tokens (web and MCP) last ACCESS_TOKEN_MINUTES; sessions renew with a rotating
# refresh token and end after SESSION_IDLE_DAYS without use or SESSION_MAX_DAYS after sign-in.
ACCESS_TOKEN_MINUTES=60
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# Lock an account for LOGIN_LOCKOUT_MINUTES after LOGIN_MAX_FAILURES wrong passwords in a row.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPTS_PER_MINUTE=10
# Questions per user to the in-app assistant (0 = no limit).
QUESTIONS_PER_HOUR=60
QUESTIONS_PER_DAY=300

# MCP server at /mcp: document search for AI assistants such as Claude Code (docs/mcp-server.md).
# Clients sign in with OAuth using the same accounts.
MCP_ENABLED=true
MCP_RATE_LIMIT_PER_MINUTE=30
MCP_CLIENT_REGISTRATIONS_PER_HOUR=20
# https hosts allowed to receive sign-in codes besides localhost (JSON list; subdomains included).
# MCP_REDIRECT_HOSTS=["claude.ai","claude.com"]
# JSON lists. Add your domain to the allowed hosts and origins when serving beyond localhost.
# MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*"]
# MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*","http://[::1]:*"]
## Local diagnostics (Compose sets an absolute container path). REQUEST_TRACE_FILES=false stops the
## per-question report files; the database summary behind the Health page is always kept.
REQUEST_TRACE_DIR=logs/traces
# REQUEST_TRACE_FILES=true
# METRICS_RETENTION_DAYS=90
# GROQ_DAILY_TOKEN_LIMIT=200000

